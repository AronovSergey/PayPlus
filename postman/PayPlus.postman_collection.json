{
  "info": {
    "name": "PayPlus API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "merchantId",
      "value": ""
    },
    {
      "key": "walletId",
      "value": ""
    },
    {
      "key": "transactionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status is ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Merchants",
      "item": [
        {
          "name": "Create Merchant",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/merchants",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Merchant\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('merchantId', res.id);",
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('status is active', () => pm.expect(res.status).to.eql('active'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Merchant by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/merchants/{{merchantId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('has id', () => pm.expect(pm.response.json().id).to.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Merchants (page 1)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/merchants?page=1&limit=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('has data array', () => pm.expect(pm.response.json().data).to.be.an('array'));",
                  "pm.test('has total', () => pm.expect(pm.response.json().total).to.be.a('number'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List Merchants (page 2)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/merchants?page=2&limit=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('has data array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Merchant Status",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/merchants/{{merchantId}}/status",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"inactive\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status is inactive', () => pm.expect(pm.response.json().status).to.eql('inactive'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Wallets",
      "item": [
        {
          "name": "Create Wallet",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/wallets",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"externalId\": \"emp-001\",\n  \"currency\": \"ILS\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('walletId', res.id);",
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('balance is 0', () => pm.expect(res.balance).to.eql('0.00'));",
                  "pm.test('status is active', () => pm.expect(res.status).to.eql('active'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Wallet by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/wallets/{{walletId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('has balance', () => pm.expect(pm.response.json().balance).to.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Wallets (page 1)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/wallets?page=1&limit=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('has data array', () => pm.expect(pm.response.json().data).to.be.an('array'));",
                  "pm.test('has total', () => pm.expect(pm.response.json().total).to.be.a('number'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List Wallets (page 2)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/wallets?page=2&limit=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('has data array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Deposit",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/wallets/{{walletId}}/deposit",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"500.00\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('balance updated', () => pm.expect(Number(pm.response.json().balance)).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Wallet Status",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/wallets/{{walletId}}/status",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"inactive\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status is inactive', () => pm.expect(pm.response.json().status).to.eql('inactive'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Charge — success",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/transactions/charge",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"walletId\": \"{{walletId}}\",\n  \"merchantId\": \"{{merchantId}}\",\n  \"amount\": \"10.00\",\n  \"currency\": \"ILS\",\n  \"idempotencyKey\": \"charge-001\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('transactionId', res.id);",
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('transaction completed', () => pm.expect(res.status).to.eql('completed'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Charge — insufficient funds",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/transactions/charge",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"walletId\": \"{{walletId}}\",\n  \"merchantId\": \"{{merchantId}}\",\n  \"amount\": \"999999.00\",\n  \"currency\": \"ILS\",\n  \"idempotencyKey\": \"charge-insufficient\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('code is insufficient_funds', () => pm.expect(res.error.code).to.eql('insufficient_funds'));",
                  "pm.test('has details', () => pm.expect(res.error.details).to.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "Charge — idempotency (duplicate key)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/transactions/charge",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"walletId\": \"{{walletId}}\",\n  \"merchantId\": \"{{merchantId}}\",\n  \"amount\": \"10.00\",\n  \"currency\": \"ILS\",\n  \"idempotencyKey\": \"charge-001\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('returns same transaction id', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('transactionId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Charge — wallet inactive",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/transactions/charge",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"walletId\": \"{{walletId}}\",\n  \"merchantId\": \"{{merchantId}}\",\n  \"amount\": \"10.00\",\n  \"currency\": \"ILS\",\n  \"idempotencyKey\": \"charge-wallet-inactive\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('transaction declined', () => pm.expect(pm.response.json().status).to.eql('declined'));",
                  "pm.test('reason is wallet_inactive', () => pm.expect(pm.response.json().declineReason).to.eql('wallet_inactive'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refund — success",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/transactions/refund",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"originalTransactionId\": \"{{transactionId}}\",\n  \"idempotencyKey\": \"refund-001\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('refundTransactionId', res.id);",
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('type is refund', () => pm.expect(res.type).to.eql('refund'));",
                  "pm.test('status is completed', () => pm.expect(res.status).to.eql('completed'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refund — idempotency (duplicate key)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/transactions/refund",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"originalTransactionId\": \"{{transactionId}}\",\n  \"idempotencyKey\": \"refund-001\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('returns same refund id', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('refundTransactionId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Transaction by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/transactions/{{transactionId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('has id', () => pm.expect(pm.response.json().id).to.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Transactions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/transactions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List Transactions — filter by walletId",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/transactions?walletId={{walletId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('all belong to wallet', () => pm.response.json().forEach(t => pm.expect(t.walletId).to.eql(pm.collectionVariables.get('walletId'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "List Transactions — filter by type",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/transactions?type=charge"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('all are charges', () => pm.response.json().forEach(t => pm.expect(t.type).to.eql('charge')));"
                ]
              }
            }
          ]
        },
        {
          "name": "List Transactions — filter by status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/transactions?status=completed"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('all are completed', () => pm.response.json().forEach(t => pm.expect(t.status).to.eql('completed')));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
